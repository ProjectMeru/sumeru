<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- Window Action -->
        <record id="action_{{.ModuleName}}" model="sys.action.window">
            <field name="name">{{.DisplayName}}</field>
            <field name="core_model">{{.ModelName}}</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="help" type="html">
                <p class="sum-view-nocontent-smiling-face">
                    Create your first {{.DisplayName}}!
                </p>
            </field>
        </record>
    </data>
</sumeru>
