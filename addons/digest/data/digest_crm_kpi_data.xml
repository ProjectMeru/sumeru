<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data noupdate="1">
        <record id="digest_crm_default" model="digest.digest">
            <field name="name">CRM Digest</field>
            <field name="periodicity">weekly</field>
            <field name="active">True</field>
        </record>
        <record id="digest_kpi_crm_lead_count" model="digest.kpi">
            <field name="name">New Leads</field>
            <field name="digest_id" ref="digest_crm_default"/>
            <field name="compute_code">crm.lead_count</field>
        </record>
        <record id="digest_kpi_crm_lead_won_count" model="digest.kpi">
            <field name="name">Won Opportunities</field>
            <field name="digest_id" ref="digest_crm_default"/>
            <field name="compute_code">crm.lead_won_count</field>
        </record>
        <record id="digest_kpi_crm_opportunity_count" model="digest.kpi">
            <field name="name">Open Opportunities</field>
            <field name="digest_id" ref="digest_crm_default"/>
            <field name="compute_code">crm.opportunity_count</field>
        </record>
    </data>
</sumeru>
