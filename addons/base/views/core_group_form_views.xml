<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_core.group_form" model="core.group" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. Sales / User"/>
                    </h1>
                </div>
                <group>
                    <group string="Identification">
                        <field name="category_id" string="Application"/>
                        <field name="sequence" string="Display Order"/>
                    </group>
                    <group string="Hierarchy">
                        <field name="implied_ids" widget="many2many_tags" string="Implied Groups"/>
                    </group>
                </group>
            </sheet>
        </view>
    </data>
</sumeru>
