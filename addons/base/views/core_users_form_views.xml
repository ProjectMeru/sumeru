<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- sys.view : core.user (form) -->
        <view id="view_core.user_form" model="core.user" type="form">
            <report download="csv,pdf" upload="bulk"/>
            <header>
                <button name="action_archive" string="Archive" type="object" class=""/>
                <button name="action_reset_password" string="Email login link" type="object" class="sum_highlight" invisible_expr="id &lt;= 0"/>
            </header>
            <sheet>
                <div class="sum_button_box" name="button_box">
                </div>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. Mitchell Admin"/>
                    </h1>
                    <div class="sum-title-contact-row">
                        <field name="email" string="Email" widget="email"/>
                        <field name="phone" string="Work phone"/>
                        <field name="mobile" string="Mobile"/>
                    </div>
                </div>

                <group>
                    <group string="Access">
                        <field name="login" string="Login"/>
                        <field name="active" string="Active" widget="boolean_toggle"/>
                        <field name="user_type" string="User Type" widget="selection"/>
                        <field name="gender" string="Gender" widget="selection"/>
                        <field name="color" string="Color" widget="color"/>
                    </group>
                    <group string="Company">
                        <field name="company_id" string="Company" widget="selection"/>
                        <field name="company_ids" string="Allowed Companies" widget="selection"/>
                    </group>
                </group>

                <notebook>
                    <page string="Preferences">
                        <group>
                            <group string="Localization">
                                <field name="lang" string="Language" widget="selection"/>
                                <field name="tz" string="Timezone" widget="selection"/>
                                <field name="action_id" string="Home Action"/>
                            </group>
                            <group string="Signature">
                                <field name="signature" string="Email signature"/>
                            </group>
                        </group>
                    </page>
                    <page string="Access Rights">
                        <!-- Groups and allowed companies render from SWC userSecurity payload. -->
                    </page>
                    <page string="Account Security">
                        <group>
                            <label for="login" string="Login is used to sign in. Keep it unique."/>
                            <field name="login" string="Login"/>
                            <field name="totp_enabled" string="Two-Factor Authentication" readonly="true"/>
                            <field name="password_min_len" string="Min Password Length"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</sumeru>
