<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_core_partner_kanban" model="core.partner" type="kanban">
            <field name="color" invisible="1"/>
            <field name="gender" invisible="1"/>
            <field name="image"/>
            <field name="name" string="Name"/>
            <field name="email" string="Email"/>
            <field name="phone" string="Phone"/>
            <field name="city_id" string="City"/>
            <field name="is_company" string="Is Company"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="sum-kanban-global-click">
                        <div class="sum-kanban-details">
                            <strong class="sum-kanban-record-title">
                                <field name="name" />
                            </strong>
                            <div>
                                <field name="email" />
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </view>
    </data>
</sumeru>